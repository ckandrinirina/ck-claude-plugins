# macOS
.DS_Store

# Nested plugin repos — each has its own git history/remote
/ck-code/
/ck-code-lite/
/ck-tools/
/ck-oneshot/

# Machine-local Claude Code settings
.claude/settings.local.json

# Local changelog previews (CI fetches these from each plugin repo)
/site/ck-code-changelog.md
/site/ck-code-lite-changelog.md
/site/ck-tools-changelog.md
/site/ck-oneshot-changelog.md

# Playground test projects (own git repos, recreated by scripts/playground.sh)
/playground/ck-*-demo/
/playground/logs/
